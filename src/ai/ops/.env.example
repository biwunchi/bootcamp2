# Bootcamp Community - example environment variables
#
# 사용 방법:
#   1. 이 파일을 복사하여 .env 또는 .env.local 로 이름을 바꿉니다.
#   2. 각 값을 실제 프로젝트 환경에 맞게 채웁니다.
#   3. 실제 값이 들어간 .env* 파일은 절대 Git에 커밋하지 마세요.
#
# 주의:
# - NEXT_PUBLIC_ 로 시작하는 키는 브라우저에 노출됩니다.
#   (민감 정보는 절대 넣지 말 것)

# 앱 환경
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 서버 전용 Supabase 키 (절대 브라우저에 노출 금지)
# - 로컬: .env.local 등에만 설정
# - Vercel: Project Settings → Environment Variables (Preview/Production)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# 업로드/스토리지 관련 (예: 작품 이미지 업로드)
# 클라이언트에서 용량 제한 안내/검증에 사용 가능
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# 선택 사항: 모니터링/분석 도구 (사용 시에만 설정)
# SENTRY_DSN=YOUR_SENTRY_DSN
# POSTHOG_API_KEY=YOUR_POSTHOG_API_KEY
